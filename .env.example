PROJECT_NAME="Matrix Inversion Distributed Service"
API_V1_STR="/api"

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=matrix_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/matrix_db

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

SECRET_KEY=super-secret-jwt-key-change-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=admin123

MAX_MATRIX_SIZE=600
MIN_MATRIX_SIZE=2
MAX_ACTIVE_TASKS_PER_USER=2
MAX_HISTORY_TASKS_PER_USER=20
TASK_SOFT_TIME_LIMIT_SEC=60
TASK_HARD_TIME_LIMIT_SEC=70

MIN_WORKERS=2
MAX_WORKERS=4
